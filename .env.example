# Next Genn Edu Tuition Assistant - Environment Configuration

# Server & Timezone Settings
TIMEZONE="Asia/Kuala_Lumpur"
PORT=3000
HOST="127.0.0.1"

# Data Directories
DATA_DIR="./data"
ROSTER_PATH="./config/roster.json"

# Classroom Policies
DEFAULT_LESSONS_PER_MONTH=4
DEFAULT_LESSON_DURATION_MINUTES=60
ALLOW_CARRY_FORWARD=true
TRY_ORIGINAL_MONTH_FIRST=true

# Security & Redaction
STRICT_PRIVACY_FILTER=true
REDACT_SENSITIVE_TOKENS=true
